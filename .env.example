# Public Supabase values (safe in the browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Canonical production URL
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN

# Preferred modern server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Storage bucket names
SUPABASE_FILES_BUCKET=important-files
SUPABASE_VIDEOS_BUCKET=videos

# Generate separate long random secrets
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
SHARE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SHARE_ANALYTICS_SALT=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
VIDEO_REPAIR_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
HEALTH_CHECK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_VALUE

# Optional limits and integrations
FILES_MAX_UPLOAD_BYTES=262144000
VIDEOS_MAX_UPLOAD_BYTES=2147483648
WORKSPACE_STORAGE_QUOTA_BYTES=10737418240
# ASSIGNMENT_EMAIL_WEBHOOK_URL=https://example.com/webhook
# ASSIGNMENT_EMAIL_WEBHOOK_SECRET=REPLACE_ME
